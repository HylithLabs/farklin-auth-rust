# Copy to .env (or export these in your shell) before `cargo run`.
# docker-compose.dev.yml exposes matching ports for local dev.

SERVICE_DB_URL=postgres://farklin:farklin@localhost:5434/farklin_auth
SERVICE_WEB_FOLDER=web-folder

SUPERTOKENS_CORE_URL=http://localhost:3567
# Only required once the core is started with API_KEYS set (not the case
# in docker-compose.dev.yml — dev core has no key).
# SUPERTOKENS_API_KEY=
